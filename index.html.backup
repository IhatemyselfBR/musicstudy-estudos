<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>MusicStudy - Estudos</title>
<style>
:root{--bg:#101116;--card:#1b1d27;--text:#f2f2f7;--muted:#999bad;--accent:#a78bfa;--border:#30313e}
*{box-sizing:border-box}
body{margin:0;padding:18px;background:var(--bg);color:var(--text);font-family:Arial,sans-serif}
header{margin-bottom:22px}
.top{display:flex;align-items:center;gap:12px;margin-bottom:22px}
button{border:0;cursor:pointer;color:var(--text);background:var(--card);padding:13px 16px;border-radius:12px;font-size:14px}
.back{padding:10px 13px}
h1{font-size:25px;margin:0 0 7px}
.subtitle{color:var(--muted);font-size:14px}
.tabs{display:flex;gap:9px;overflow-x:auto;padding-bottom:12px;margin-bottom:14px}
.tab{white-space:nowrap;border:1px solid var(--border)}
.tab.active{background:var(--accent);color:#171321}
.search{width:100%;padding:15px;border-radius:12px;border:1px solid var(--border);background:var(--card);color:var(--text);font-size:15px;outline:none;margin-bottom:18px}
.section-title{font-size:17px;margin:10px 0 15px}
.cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.card{background:var(--card);border:1px solid var(--border);border-radius:15px;overflow:hidden;min-width:0}
.card img{width:100%;height:145px;object-fit:contain;background:#242532;display:block}
.placeholder{height:145px;background:#242532;display:flex;align-items:center;justify-content:center;color:var(--muted);font-size:34px}
.card-info{padding:12px}
.card h3{font-size:16px;margin:0 0 7px;overflow-wrap:anywhere}
.card p{font-size:12px;color:var(--muted);margin:0;overflow-wrap:anywhere}
.add{width:100%;margin-top:20px;background:var(--accent);color:#171321;font-weight:bold;padding:16px}
.empty{color:var(--muted);text-align:center;padding:35px 10px;grid-column:1/-1}
.status{font-size:12px;color:var(--muted);margin:8px 0 6px}
.refresh-row{display:flex;justify-content:flex-end;margin:0 0 14px}
.refresh-button{padding:5px 9px;border:1px solid var(--border);border-radius:8px;font-size:12px;color:var(--muted);background:transparent}
.modal{display:none;position:fixed;inset:0;background:#000b;align-items:center;justify-content:center;padding:18px}
.modal-box{background:var(--card);border:1px solid var(--border);border-radius:18px;padding:20px;width:100%;max-width:430px}
.modal-box h2{margin-top:0}
.modal-box input,.modal-box textarea{width:100%;padding:13px;margin:7px 0 12px;background:#101116;color:var(--text);border:1px solid var(--border);border-radius:10px;font-size:15px}
.modal-box textarea{min-height:85px;resize:vertical}
.modal-actions{display:flex;gap:9px;margin-top:15px}
.modal-actions button{flex:1}
.primary{background:var(--accent);color:#171321;font-weight:bold}
#imageStatus{font-size:12px;color:var(--muted);margin-top:8px}
</style>
</head>
<body>
<header>
 <div class="top">
  <button class="back" id="backButton" onclick="if(window.Android)Android.close()">← Voltar</button>
  <span style="color:var(--muted)">MUSICSTUDY</span>
 </div>
 <h1>Área de estudos</h1>
 <div class="subtitle">Biblioteca compartilhada de teoria musical.</div>
</header>
<nav class="tabs">
 <button class="tab active" data-category="Campo Harmônico">Campo Harmônico</button>
 <button class="tab" data-category="Escalas">Escalas</button>
 <button class="tab" data-category="Acordes">Acordes</button>
</nav>
<input id="search" class="search" placeholder="⌕  Pesquisar conteúdo...">
<div class="status" id="status">Carregando biblioteca...</div>
<div class="refresh-row"><button class="refresh-button" onclick="loadShared()">↻ Atualizar</button></div>
<div class="section-title" id="sectionTitle">Campo Harmônico</div>
<div class="cards" id="cards"></div>
<button class="add" id="addButton" onclick="openModal()">＋ Adicionar conteúdo</button>
<button class="add" id="exportButton" style="display:none" onclick="exportLibrary()">↑ Exportar biblioteca para publicação</button>

<div class="modal" id="modal">
 <div class="modal-box">
  <h2>Adicionar conteúdo</h2>
  <input id="name" placeholder="Nome (ex.: Dó maior)">
  <textarea id="description" placeholder="Descrição ou observações (opcional)"></textarea>
  <button style="width:100%" onclick="Android.chooseImage()">＋ Escolher imagem da galeria</button>
  <div id="imageStatus">Nenhuma imagem selecionada.</div>
  <div class="modal-actions">
   <button onclick="closeModal()">Cancelar</button>
   <button class="primary" onclick="saveItem()">Salvar</button>
  </div>
 </div>
</div>

<script>
let category="Campo Harmônico";
let selectedImage=null;
let sharedData={"Campo Harmônico":[],"Escalas":[],"Acordes":[]};
const isApp=!!window.Android;

if(!isApp){
 document.getElementById("addButton").style.display="none";
 document.getElementById("backButton").style.display="none";
}else{
 document.getElementById("exportButton").style.display="block";
}
loadShared();

function key(c){return "musicstudy_site_"+c}
function getLocal(c){
 try{return JSON.parse(localStorage.getItem(key(c))||"[]")}
 catch(e){return []}
}
function getItems(){
 if(!isApp) return sharedData[category]||[];
 const local = getLocal(category);
 const shared = sharedData[category]||[];
 const merged = [...shared];
 for(const item of local){
  if(!merged.some(x=>x.name===item.name && x.description===item.description)){
   merged.push(item);
  }
 }
 return merged;
}
async function loadShared(){
 try{
  const r=await fetch("https://ihatemyselfbr.github.io/musicstudy-estudos/dados.json?v="+Date.now(),{cache:"no-store"});
  if(!r.ok)throw new Error("Biblioteca ainda não publicada.");
  const d=await r.json();
  for(const c of ["Campo Harmônico","Escalas","Acordes"])
   sharedData[c]=Array.isArray(d[c])?d[c]:[];
  document.getElementById("status").textContent="Biblioteca compartilhada atualizada.";
 }catch(e){
  document.getElementById("status").textContent="Não foi possível carregar a biblioteca compartilhada.";
 }
 render();
}
function render(){
 const term=document.getElementById("search").value.toLowerCase();
 const cards=document.getElementById("cards");
 const items=getItems().filter(x=>
  (x.name||"").toLowerCase().includes(term)||
  (x.description||"").toLowerCase().includes(term)
 );
 document.getElementById("sectionTitle").textContent=category;
 cards.innerHTML="";
 if(!items.length){
  cards.innerHTML='<div class="empty">Nenhum conteúdo encontrado.</div>';
  return;
 }
 items.forEach(item=>{
  const card=document.createElement("article");card.className="card";
  if(item.image){
   const img=document.createElement("img");
   img.src=/^(data:|https?:\/\/)/i.test(item.image) ? item.image : "https://ihatemyselfbr.github.io/musicstudy-estudos/"+item.image.replace(/^\//,"");
   img.alt=item.name||"Imagem de estudo";
   card.appendChild(img);
  }else{
   const ph=document.createElement("div");ph.className="placeholder";
   ph.textContent="♪";card.appendChild(ph);
  }
  const info=document.createElement("div");info.className="card-info";
  const title=document.createElement("h3");title.textContent=item.name||"Sem nome";
  const desc=document.createElement("p");desc.textContent=item.description||"";
  info.append(title,desc);card.appendChild(info);cards.appendChild(card);
 });
}
document.querySelectorAll(".tab").forEach(btn=>btn.addEventListener("click",()=>{
 category=btn.dataset.category;
 document.querySelectorAll(".tab").forEach(x=>x.classList.remove("active"));
 btn.classList.add("active");
 document.getElementById("search").value="";
 render();
}));
document.getElementById("search").addEventListener("input",render);

function openModal(){
 selectedImage=null;
 document.getElementById("name").value="";
 document.getElementById("description").value="";
 document.getElementById("imageStatus").textContent="Nenhuma imagem selecionada.";
 document.getElementById("modal").style.display="flex";
}
function closeModal(){document.getElementById("modal").style.display="none"}
function saveItem(){
 const name=document.getElementById("name").value.trim();
 const description=document.getElementById("description").value.trim();
 if(!name){alert("Digite o nome do conteúdo.");return}
 try{
  const items=getLocal(category);
  items.push({name,description,image:selectedImage});
  localStorage.setItem(key(category),JSON.stringify(items));
  closeModal();render();
 }catch(e){alert("Não foi possível salvar. Tente uma imagem menor.")}
}
window.onImageSelected=function(data){
 if(!data){document.getElementById("imageStatus").textContent="Imagem não selecionada.";return}
 selectedImage=data;
 document.getElementById("imageStatus").textContent="Imagem selecionada com sucesso!";
};
function exportLibrary(){
 const data={};
 for(const c of ["Campo Harmônico","Escalas","Acordes"])data[c]=getLocal(c);
 Android.exportData(JSON.stringify(data));
}
render();
</script>
</body>
</html>
